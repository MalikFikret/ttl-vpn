<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match the Compose background, so there's no flash before the first frame -->
    <color name="window_background">#FFF7F9F9</color>

    <!-- Home screen widget: resolved by the launcher with the phone's own
         light/dark mode, so the widget follows the phone, not the in-app theme -->
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_outline">#FFC3CDCB</color>
    <color name="widget_on_surface">#FF171D1D</color>
    <color name="widget_on_surface_variant">#FF3F4947</color>
    <color name="widget_badge_off">#FFE5E9E8</color>
    <color name="widget_icon_off">#FF00605F</color>
    <color name="widget_badge_connecting">#FFEBE3D6</color>
    <color name="widget_icon_connecting">#FF7F5000</color>
    <color name="widget_badge_connected">#FF2E9A4F</color>
    <color name="widget_icon_connected">#FFFFFFFF</color>
    <color name="widget_badge_error">#FFFFDAD6</color>
    <color name="widget_icon_error">#FFBA1A1A</color>
</resources>
