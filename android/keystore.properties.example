# Template for the release signing properties. Placeholders only: never put real values here.
#
# Copy this file OUTSIDE the repository (for example next to the keystore), fill it in, and set
# the environment variable TTLVPN_KEYSTORE_PROPERTIES to its full path. The build refuses a file
# or keystore inside the repo.
#
# Alternatively, skip this file and set the environment variables TTLVPN_KEYSTORE,
# TTLVPN_KEYSTORE_PASSWORD, TTLVPN_KEY_ALIAS and (optional) TTLVPN_KEY_PASSWORD. Don't set both.

# Keystore path. A relative path is resolved against the folder of this properties file.
storeFile=C:/path/outside/the/repo/ttl-vpn-release.jks
storePassword=CHANGE_ME
keyAlias=ttlvpn
# Optional. Defaults to storePassword (PKCS12 keystores use one password for both).
#keyPassword=CHANGE_ME
